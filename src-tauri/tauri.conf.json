{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anivar",
  "version": "0.1.0",
  "identifier": "com.anivar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Anivar",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "additionalBrowserArgs": "--enable-features=WebGPU"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob: mediastream: http://localhost:*; img-src 'self' blob: data: http://localhost:*; connect-src 'self' http://localhost:* ws://localhost:* https://huggingface.co https://*.huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.nivar.app/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4OTVDQjczNzAxQUYxRUQKUldUdDhScHdjOHVWbU5uM01xcC9yM2g5TENaSjVrRlpLbWhEbjEvenNpNUpKQWpHYVZWc3pEQVYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Anivar",
    "category": "Utility",
    "copyright": "\u00a9 2026 Anivar",
    "shortDescription": "Local-AI security camera NVR",
    "longDescription": "Anivar is a private, local-first AI security NVR: continuous recording, on-device person/face/plate detection, and an agentic guardian \u2014 no cloud required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
